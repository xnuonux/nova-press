# anthropic ... claude api for nova partner
ANTHROPIC_API_KEY=

# supabase ... pieces, drafts, subscribers
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# database direct ... pg-boss + migrations
DATABASE_URL=

# site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# optional ... voyage embeddings for voice corpus
VOYAGE_API_KEY=

# optional ... resend for subscriber confirmations + the newsletter blast
RESEND_API_KEY=
# the from-address every nova email sends as (e.g. "nova <hi@yourdomain.com>").
# blank keeps every send stubbed ... it is the second half of the live switch.
NOVA_EMAIL_FROM=
# the deliberate prod-only live switch. real email sends ONLY when this is the
# literal "true" AND a key + from are set. leave it UNSET everywhere except the
# true production environment ... NODE_ENV is "production" in vercel preview +
# branch deploys too, so this flag (not NODE_ENV) is what keeps previews stubbed.
NOVA_EMAIL_LIVE=
