# enforce conventional commits and lowercase voice rule
commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# allow: feat, fix, refactor, docs, chore, test, style, perf, ci, build, revert
pattern="^(feat|fix|refactor|docs|chore|test|style|perf|ci|build|revert)(\([a-z0-9-]+\))?: [a-z]"

if ! echo "$commit_msg" | head -1 | grep -qE "$pattern"; then
  echo ""
  echo "blocked: commit message must follow conventional commits and start lowercase."
  echo "examples:"
  echo "  feat(editor): wire plate ai panel"
  echo "  fix(reading-view): drop cap overflow on mobile"
  echo "  chore: bump deps"
  echo ""
  exit 1
fi

# block em-dashes anywhere in the message
if echo "$commit_msg" | grep -q '—'; then
  echo "blocked: em-dash in commit message. use ... for pauses."
  exit 1
fi

exit 0
